# WARNING: This file is for LOCAL DEVELOPMENT ONLY.
# NEVER use these values in production.
# All production secrets MUST come from KMS (kms.hanzo.ai).

# Generate a local dev RSA key: openssl genpkey -algorithm RSA -out /dev/stdout -pkeyopt rsa_keygen_bits:2048
OIDC_RSA_PRIVATE_KEY="generate-local-dev-key-see-comment-above"

# RS256 private key for sandbox JWT authentication (public key is derived from this)
# Generate: openssl genpkey -algorithm RSA -out /dev/stdout -pkeyopt rsa_keygen_bits:2048
SANDBOX_JWT_PRIVATE_KEY="generate-local-dev-key-see-comment-above"

# [[HANZO IAM OIDC]] (required for production SSO)
# Hanzo IAM provides the `owner` claim for org mapping.
# Production values come from KMS (kms.hanzo.ai).
SOCIAL_AUTH_OIDC_OIDC_ENDPOINT="https://hanzo.id"
SOCIAL_AUTH_OIDC_KEY=""
SOCIAL_AUTH_OIDC_SECRET=""
SOCIAL_AUTH_OIDC_REDIRECT_URI="https://insights.hanzo.ai/complete/oidc/"
SOCIAL_AUTH_OIDC_ID_TOKEN_ISSUER="https://hanzo.id"
