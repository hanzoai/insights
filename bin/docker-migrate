#!/bin/bash
set -e

# RED H1: delegate to ./bin/migrate so this runs the FULL migration set —
# Postgres (manage.py migrate) + Datastore (migrate_datastore) + persons.
# The old `manage.py migrate` alone left the `insights` Datastore schema
# uncreated, so web/worker 500'd on every analytics query.
exec "$(dirname "$0")/migrate"