         "insights_filesystemshortcut"."href",
         "insights_filesystemshortcut"."order",
         "insights_filesystemshortcut"."created_at",
         "insights_filesystemshortcut"."surface"
  FROM "insights_filesystemshortcut"
  WHERE (("insights_filesystemshortcut"."surface" IS NULL
          OR "insights_filesystemshortcut"."surface" = 'web')
         AND "insights_filesystemshortcut"."ref" = '0001'
         AND "insights_filesystemshortcut"."team_id" = 99999
         AND "insights_filesystemshortcut"."type" = 'cohort'
         AND NOT ("insights_filesystemshortcut"."path" = 'Users with feature flag some-feature enabled at 2021-01-01 00:00:00'
                  AND "insights_filesystemshortcut"."href" = '__skipped__'
