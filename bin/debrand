# --- attribution --------------------------------------------------------
#
# A licence is the one text in the tree that is not ours to rewrite. The MIT
# grant we hold this code under is conditioned on carrying the original
# copyright notice forward, so renaming the upstream company inside a licence
# both breaks that condition and asserts our copyright over their code. It is
# also invisible: the file still reads like a valid licence.
#
# This is structural, not an allowlist entry, because the allowlist is a list
# someone can add to and this must not be opt-out-able. Paths still rename —
# a licence that moves with its directory is fine. Only the bytes are frozen.

LICENCE_FILE = re.compile(
    r"^(licen[cs]e|copying|copyright|notice)"     # the notice itself
    r"([-_][a-z0-9\-]+)?"                         # an optional variant: LICENSE-MIT
    r"(\.(md|txt|rst|markdown))?$",               # prose only: license.py is a module
    re.IGNORECASE,
)


def is_licence(path: str) -> bool:
    return bool(LICENCE_FILE.match(os.path.basename(path)))


