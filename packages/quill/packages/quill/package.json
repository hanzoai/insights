{
  "name": "@hanzo/quill",
  "version": "0.3.0-beta.16",
  "description": "Insights's unified design system \u2014 primitives, components, and blocks designed to be compiled by the consumer's Tailwind v4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/insights.git",
    "directory": "packages/quill/packages/quill"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./base.css": "./dist/base.css",
    "./primitives.css": "./dist/primitives.css",
    "./tokens.css": "./dist/tokens.css",
    "./color-system.css": "./dist/color-system.css",
    "./tokens.scoped.css": "./dist/tokens.scoped.css",
    "./base.scoped.css": "./dist/base.scoped.css",
    "./color-system.scoped.css": "./dist/color-system.scoped.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build-css.ts && vite build",
    "build:css": "tsx scripts/build-css.ts",
    "build:js": "vite build"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react-resizable-panels": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@hanzo/quill-blocks": "workspace:*",
    "@hanzo/quill-components": "workspace:*",
    "@hanzo/quill-primitives": "workspace:*",
    "@hanzo/quill-tokens": "workspace:*",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8",
    "tailwindcss": ">=4"
  },
  "engines": {
    "node": ">=20"
  }
}
