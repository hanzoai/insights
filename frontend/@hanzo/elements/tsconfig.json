{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "noEmit": false,
        // The root config sets "incremental": true, which the app build wants and
        // this one cannot use: `tsup --dts-only` drives tsc without a tsconfig
        // path and without --tsBuildInfoFile, so TypeScript refuses with
        //   TS5074: Option '--incremental' can only be specified using tsconfig,
        //   emitting to single file or when option '--tsBuildInfoFile' is specified
        // and the image build dies at `turbo build`.
        //
        // Off here rather than at the root: incremental is a real speedup for the
        // 2,400-file app, and this package emits declarations only.
        "incremental": false
    }
}
