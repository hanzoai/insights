{
    // baseUrl is what makes the inherited `paths` resolve to one place no matter
    // who reads this file.
    //
    // The root config maps "lib/*" to "./frontend/src/lib/*" and declares NO
    // baseUrl. TypeScript's own rule is that paths without a baseUrl resolve
    // relative to the config file that DECLARES them, so `tsc` reads that as
    // <repo>/frontend/src/lib/* and is happy — which is why the typecheck job is
    // green while the build job is not.
    //
    // tsup's dts pass does not agree. It resolves the same relative entry against
    // THIS directory, looks for frontend/@hanzo/elements/frontend/src/lib/*, finds
    // nothing, and every `export * from 'lib/elements/...'` in src/index.ts fails
    // as TS2307 — "Cannot find module 'lib/elements/Popover'". A resolver
    // disagreement, not a missing file: all of those modules exist.
    //
    // Pointing baseUrl at the repo root removes the disagreement rather than
    // arguing it. With a baseUrl present, paths are resolved against it by
    // definition, so both readers land on <repo>/frontend/src/lib/*.
    //
    // Set here and not in the root config on purpose: adding baseUrl at the root
    // would give every bare specifier in the tree a new resolution root, and the
    // typecheck that passes today is the evidence the root is fine as it is. The
    // blast radius of this line is one package's build.
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": "../../..",
        "emitDeclarationOnly": true,
        // The root turns `incremental` on, which suits a project that type-checks
        // itself in place. tsup's dts pass is not that: it emits declarations to a
        // directory with no build-info file, and TypeScript refuses the pair —
        // "error TS5074: Option '--incremental' can only be specified using
        // tsconfig, emitting to single file or when option '--tsBuildInfoFile' is
        // specified". This surfaced only once baseUrl made tsup honour the config
        // at all; before that it never got far enough to read `incremental`.
        //
        // Off rather than pointing at a tsBuildInfoFile: the cache would buy
        // nothing here. Each build runs once in a fresh container, so there is no
        // prior run for it to reuse, and a stale one would be a liability.
        "incremental": false,
        "noEmit": false
    }
}
