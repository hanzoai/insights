#!/bin/bash
set -e

if [[ "$@" == *".iqle"* ]]; then
  if [[ "$@" == *"--python"* ]]; then
    exec python3 -m common.scriptvm.python.cli "$@"

  elif [[ "$@" == *"--debug"* ]]; then
    echo "Running in Python VM with debug mode"
    exec python3 -m common.scriptvm.python.cli "$@"

  else # default to nodejs because it's fastest
    set -- "${@/--nodejs/}"
    VM_PATH="$(dirname "$0")/../common/scriptvm/typescript"
    CLI_PATH="$(dirname "$0")/../common/scriptvm/typescript/dist/cli.js"
    # TODO: recompile if something changed
    if [ ! -f $CLI_PATH ]; then
      echo "Building TypeScript ScriptVM"
      cd $VM_PATH
      pnpm run build
      cd -
    fi
    exec node $CLI_PATH "$@"
  fi
elif [[ "$@" == *"--out"* ]]; then
  exec python3 -m insights.insightsql.cli --out "$@"
elif [[ "$@" == *".iql"* ]]; then
  exec python3 -m insights.insightsql.cli --run "$@"
else
  echo "$0 - Insights Query Language"
  echo ""
  echo "Usage:     bin/iql <file.iql>                 run .iql source code"
  echo "           bin/iql <file.iqle>                run compiled .iqle bytecode"
  echo "           bin/iqle <file.iql> [output.iqle]  compile .iql into .iqle"
  echo ""
  echo "Options:   bin/iql --debug                    run the debugger (Python only)"
  echo "           bin/iql --python                   use the Python VM"
  echo "           bin/iql --nodejs                   use the Node.js VM"
  exit 1
fi
