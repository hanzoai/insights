  FROM "insights_experiment"
  WHERE (NOT "insights_experiment"."deleted"
         AND "insights_experiment"."feature_flag_id" IN (1,
                                                        2,
                                                        3,
                                                        4,
                                                        5 /* ... */))
  '''
