{
  "name": "@hanzo/quill-primitives",
  "version": "0.3.0-beta.15",
  "private": true,
  "description": "Internal workspace package (private, not published). The lowest layer of the quill design system \u2014 unstyled Base UI primitives wrapped with quill's Tailwind classes (Button, Card, Dialog, Input, Popover, Combobox, etc.). Bundled into @hanzo/quill at build time; consumers should import from @hanzo/quill instead.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/insights.git",
    "directory": "packages/quill/packages/primitives"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@hanzo/quill-tokens": "workspace:^",
    "@shadcn/react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react-resizable-panels": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@storybook/react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  }
}
