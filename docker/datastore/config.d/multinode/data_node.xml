<datastore>
    <tcp_port>9000</tcp_port>

    <remote_servers>
        <insights>
            <shard>
                <replica>
                    <host>datastore-data</host>
                    <port>9000</port>
                </replica>
            </shard>
        </insights>
        <insights_single_shard>
            <shard>
                <replica>
                    <host>datastore-data</host>
                    <port>9000</port>
                </replica>
            </shard>
        </insights_single_shard>
        <insights_writable>
            <shard>
                <replica>
                    <host>datastore-data</host>
                    <port>9000</port>
                </replica>
            </shard>
        </insights_writable>
        <insights_primary_replica>
            <shard>
                <replica>
                    <host>datastore-data</host>
                    <port>9000</port>
                </replica>
            </shard>
        </insights_primary_replica>

        <insights_migrations>
            <shard>
                <replica>
                    <host>datastore-data</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>datastore-ai-events</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>datastore-aux</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>datastore-ops</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>datastore-sessions</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>datastore-logs</host>
                    <port>9000</port>
                </replica>
            </shard>
        </insights_migrations>

        <ai_events>
            <shard>
                <replica>
                    <host>datastore-ai-events</host>
                    <port>9000</port>
                </replica>
            </shard>
        </ai_events>
        <aux>
            <shard>
                <replica>
                    <host>datastore-aux</host>
                    <port>9000</port>
                </replica>
            </shard>
        </aux>
        <ops>
            <shard>
                <replica>
                    <host>datastore-ops</host>
                    <port>9000</port>
                </replica>
            </shard>
        </ops>
        <sessions>
            <shard>
                <replica>
                    <host>datastore-sessions</host>
                    <port>9000</port>
                </replica>
            </shard>
        </sessions>
        <logs>
            <shard>
                <replica>
                    <host>datastore-logs</host>
                    <port>9000</port>
                </replica>
            </shard>
        </logs>
    </remote_servers>

    <named_collections>
        <msk_cluster>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </msk_cluster>
        <warpstream_ingestion>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_ingestion>
        <warpstream_calculated_events>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_calculated_events>
        <warpstream_replay>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_replay>
        <warpstream_shared>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_shared>
        <warpstream_cyclotron>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_cyclotron>
        <warpstream_logs>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_logs>
        <warpstream_traces>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
        </warpstream_traces>
    </named_collections>

    <macros>
        <shard>01</shard>
        <replica>data</replica>
        <hostClusterType>online</hostClusterType>
        <hostClusterRole>data</hostClusterRole>
    </macros>
</datastore>
