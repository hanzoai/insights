{
  "name": "@hanzo/quill-charts",
  "version": "0.3.0-beta.16",
  "description": "Canvas-based charting library for trends, dashboards, and any chart that needs to render thousands of points smoothly. D3 (scale/shape/color/array sub-packages) powers the scales; the canvas does the drawing; React handles overlays.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/insights.git",
    "directory": "packages/quill/packages/charts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@floating-ui/react": "catalog:",
    "d3-array": "catalog:",
    "d3-color": "catalog:",
    "d3-scale": "catalog:",
    "d3-shape": "catalog:",
    "dayjs": "catalog:",
    "simple-statistics": "catalog:"
  },
  "devDependencies": {
    "@hanzo/quill-tokens": "workspace:*",
    "@storybook/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/d3-array": "catalog:",
    "@types/d3-color": "catalog:",
    "@types/d3-scale": "catalog:",
    "@types/d3-shape": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  }
}
