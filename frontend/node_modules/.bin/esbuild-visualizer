else
  export NODE_PATH="/home/z/work/hanzo/insights/node_modules/.pnpm/esbuild-visualizer@0.6.0/node_modules/esbuild-visualizer/dist/bin/node_modules:/home/z/work/hanzo/insights/node_modules/.pnpm/esbuild-visualizer@0.6.0/node_modules/esbuild-visualizer/dist/node_modules:/home/z/work/hanzo/insights/node_modules/.pnpm/esbuild-visualizer@0.6.0/node_modules/esbuild-visualizer/node_modules:/home/z/work/hanzo/insights/node_modules/.pnpm/esbuild-visualizer@0.6.0/node_modules:/home/z/work/hanzo/insights/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../esbuild-visualizer/dist/bin/cli.js" "$@"
else
  exec node  "$basedir/../esbuild-visualizer/dist/bin/cli.js" "$@"
