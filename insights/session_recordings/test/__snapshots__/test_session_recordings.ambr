         "insights_datawarehousetable"."columns",
         "insights_datawarehousetable"."column_order",
         "insights_datawarehousetable"."options",
         "insights_datawarehousetable"."row_count",
         "insights_datawarehousetable"."size_in_s3_mib",
         "insights_user"."id",
         "insights_user"."password",
         "insights_user"."last_login",
         "insights_user"."first_name",
         "insights_user"."last_name",
         "insights_user"."is_staff",
         "insights_user"."date_joined",
         "insights_user"."uuid",
         "insights_user"."current_organization_id",
         "insights_user"."current_team_id",
