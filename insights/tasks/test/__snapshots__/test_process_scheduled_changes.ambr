         "insights_filesystemshortcut"."ref",
         "insights_filesystemshortcut"."href",
         "insights_filesystemshortcut"."created_at"
  FROM "insights_filesystemshortcut"
  WHERE ("insights_filesystemshortcut"."ref" = '0001'
         AND "insights_filesystemshortcut"."team_id" = 99999
         AND "insights_filesystemshortcut"."type" = 'feature_flag'
         AND NOT ("insights_filesystemshortcut"."path" = 'flag-1'
                  AND "insights_filesystemshortcut"."href" = '__skipped__'
                  AND "insights_filesystemshortcut"."href" IS NOT NULL))
  '''
