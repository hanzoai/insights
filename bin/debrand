# Directory renames that are ours by convention rather than by branding.
# `kafka` is scoped to the client wrapper so real vendored Kafka code and the
# livestream Go bindings keep their upstream names.
PATH_DIR_RULES: list[tuple[str, str]] = [
    ("nodejs/src/kafka/", "nodejs/src/stream/"),
    ("nodejs/src/session-recording/kafka/", "nodejs/src/session-recording/stream/"),
]

# An import specifier IS a path, so a path shares CONTENT_REGEX -- the same
# object, not a copy of it. Two lists that had to agree is precisely what kept
# not agreeing: the design-system strip landed in content and not in paths, and
# every `@hanzo/elements` import dangled; the script extension landed in paths
# and not in content, and the runner, the compiler and the files on disk ended
# up spelling it three different ways; `-hog-` was rewritten to `-mascot-` in
# paths while content said `script`, so ReviewHog's skill directories stopped
# matching the prefix that discovers them and the product silently ran with no
# perspectives at all. Sharing the list is what makes those unrepresentable --
# there is nothing left to keep in step.
#
# Every rule here is therefore constrained twice over: it must be right for a
# path AND right for a file's bytes. `\bLemon(?=[A-Z])` and nothing looser,
# because `lemon_squeezy` is Lemon Squeezy, a payments vendor whose warehouse
# source we import, and a rule matching a bare `lemon` would rename someone
# else's product. `\bhog\b` cannot reach `hedgehog`, `tophog`, `stamp`,
# `hog_invocation_results` or `hogfunction` -- every one of those is named
# above instead, because a rule that cannot reach a name has not spared it, it
# has only failed to see it.
PATH_REGEX = CONTENT_REGEX

