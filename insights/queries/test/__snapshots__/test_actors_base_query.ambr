           (SELECT U0."id"
            FROM "insights_persondistinctid" U0
            WHERE U0."person_id" = ("insights_persondistinctid"."person_id")
            LIMIT 1000)
         AND "insights_persondistinctid"."person_id" IN (1,
                                                        2,
                                                        3,
                                                        4,
                                                        5 /* ... */))
  '''
