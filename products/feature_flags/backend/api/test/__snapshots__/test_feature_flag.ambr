         T5."onboarding_delegation_accepted_at",
         T5."events_column_config",
         T5."email_opt_in"
  FROM "insights_featureflag"
  INNER JOIN "insights_team" ON ("insights_featureflag"."team_id" = "insights_team"."id")
  LEFT OUTER JOIN "insights_user" ON ("insights_featureflag"."created_by_id" = "insights_user"."id")
  LEFT OUTER JOIN "insights_user" T5 ON ("insights_featureflag"."last_modified_by_id" = T5."id")
  WHERE ("insights_team"."project_id" = 99999
         AND "insights_featureflag"."id" = 99999)
  LIMIT 21
  '''
