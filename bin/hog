#!/bin/bash
set -e

if [[ "$@" == *".hoge"* ]]; then
  if [[ "$@" == *"--python"* ]]; then
    exec python3 -m common.scriptvm.python.cli "$@"

  elif [[ "$@" == *"--debug"* ]]; then
    echo "Running in Python VM with debug mode"
    exec python3 -m common.scriptvm.python.cli "$@"

  else # default to nodejs because it's fastest
    set -- "${@/--nodejs/}"
    VM_PATH="$(dirname "$0")/../common/scriptvm/typescript"
    CLI_PATH="$(dirname "$0")/../common/scriptvm/typescript/dist/cli.js"
    # TODO: recompile if something changed
    if [ ! -f $CLI_PATH ]; then
      echo "Building TypeScript ScriptVM"
      cd $VM_PATH
      pnpm run build
      cd -
    fi
    exec node $CLI_PATH "$@"
  fi
elif [[ "$@" == *"--out"* ]]; then
  exec python3 -m insights.insightsql.cli --out "$@"
elif [[ "$@" == *".script"* ]]; then
  exec python3 -m insights.insightsql.cli --run "$@"
else
  echo "$0 - the full script! 🦔+🐗=Script"
  echo ""
  echo "Usage:     bin/script <file.script>                 run .script source code"
  echo "           bin/script <file.hoge>                run compiled .hoge bytecode"
  echo "           bin/hoge <file.script> [output.hoge]  compile .script into .hoge"
  echo ""
  echo "Options:   bin/script --debug                    run the debugger (Python only)"
  echo "           bin/script --python                   use the Python VM"
  echo "           bin/script --nodejs                   use the Node.js VM"
  exit 1
fi
