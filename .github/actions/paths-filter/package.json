{
  "name": "paths-filter",
  "version": "1.0.0",
  "private": true,
  "description": "Execute your workflow steps only if relevant files are modified.",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "author": "YourNameOrOrganization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "pack": "ncc build",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run pack && npm test"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "@actions/exec": "catalog:",
    "@actions/github": "catalog:",
    "picomatch": "catalog:"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "catalog:",
    "@types/jest": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vercel/ncc": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-github": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "jest": "catalog:",
    "jest-circus": "catalog:",
    "js-yaml": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">= 24"
  },
  "overrides": {
    "@actions/http-client": "^3.0.2",
    "undici": "^6.27.0"
  }
}
