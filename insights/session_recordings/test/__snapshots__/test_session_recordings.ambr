# name: TestSessionRecordings.test_get_session_recordings_returns_newest_first.12
  '''
  SELECT "insights_sessionrecording"."id",
         "insights_sessionrecording"."session_id",
         "insights_sessionrecording"."team_id",
         "insights_sessionrecording"."created_at",
         "insights_sessionrecording"."deleted",
         "insights_sessionrecording"."object_storage_path",
         "insights_sessionrecording"."full_recording_v2_path",
         "insights_sessionrecording"."distinct_id",
         "insights_sessionrecording"."duration",
         "insights_sessionrecording"."active_seconds",
         "insights_sessionrecording"."inactive_seconds",
         "insights_sessionrecording"."start_time",
         "insights_sessionrecording"."end_time",
         "insights_sessionrecording"."click_count",
         "insights_sessionrecording"."keypress_count",
         "insights_sessionrecording"."mouse_activity_count",
         "insights_sessionrecording"."console_log_count",
         "insights_sessionrecording"."console_warn_count",
         "insights_sessionrecording"."console_error_count",
         "insights_sessionrecording"."start_url",
         "insights_sessionrecording"."storage_version",
         "insights_sessionrecording"."retention_period_days"
  FROM "insights_sessionrecording"
  WHERE ("insights_sessionrecording"."session_id" IN ('middle_session',
                                                     'new_session',
                                                     'old_session')
         AND "insights_sessionrecording"."team_id" = 99999)
  '''
# ---
# name: TestSessionRecordings.test_get_session_recordings_returns_newest_first.13
  '''
  SELECT "insights_sessionrecordingviewed"."session_id" AS "session_id"
  FROM "insights_sessionrecordingviewed"
  WHERE ("insights_sessionrecordingviewed"."team_id" = 99999
         AND "insights_sessionrecordingviewed"."user_id" = 99999
         AND "insights_sessionrecordingviewed"."session_id" IN ('new_session',
                                                               'middle_session',
                                                               'old_session'))
  '''
# ---
# name: TestSessionRecordings.test_get_session_recordings_returns_newest_first.14
  '''
  SELECT "insights_sessionrecordingviewed"."session_id" AS "session_id",
         "insights_user"."email" AS "user__email"
  FROM "insights_sessionrecordingviewed"
  INNER JOIN "insights_user" ON ("insights_sessionrecordingviewed"."user_id" = "insights_user"."id")
  WHERE ("insights_sessionrecordingviewed"."session_id" IN ('new_session',
                                                           'middle_session',
                                                           'old_session')
         AND "insights_sessionrecordingviewed"."team_id" = 99999
         AND NOT ("insights_sessionrecordingviewed"."user_id" = 99999))
  '''
# ---
# name: TestSessionRecordings.test_get_session_recordings_returns_newest_first.15
  '''
  SELECT DISTINCT ON ("ee_single_session_summary"."session_id") "ee_single_session_summary"."session_id" AS "session_id",
                     ("ee_single_session_summary"."summary" -> 'session_outcome') AS "summary__session_outcome",
                     "ee_single_session_summary"."extra_summary_context" AS "extra_summary_context"
  FROM "ee_single_session_summary"
  WHERE ("ee_single_session_summary"."session_id" IN ('new_session',
                                                      'middle_session',
                                                      'old_session')
         AND "ee_single_session_summary"."team_id" = 99999
         AND "ee_single_session_summary"."extra_summary_context" IS NULL)
  ORDER BY 1 ASC,
           "ee_single_session_summary"."created_at" DESC
  '''
