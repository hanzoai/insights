# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.43
  '''
  SELECT "insights_sessionrecordingplaylistitem"."playlist_id" AS "playlist_id",
         COUNT("insights_sessionrecordingplaylistitem"."id") AS "c"
  FROM "insights_sessionrecordingplaylistitem"
  INNER JOIN "insights_sessionrecordingplaylist" ON ("insights_sessionrecordingplaylistitem"."playlist_id" = "insights_sessionrecordingplaylist"."id")
  WHERE ("insights_sessionrecordingplaylist"."team_id" = 99999
         AND "insights_sessionrecordingplaylistitem"."playlist_id" IN (1,
                                                                      2,
                                                                      3,
                                                                      4,
                                                                      5 /* ... */)
         AND NOT ("insights_sessionrecordingplaylistitem"."deleted"
                  AND "insights_sessionrecordingplaylistitem"."deleted" IS NOT NULL))
  GROUP BY 1
  '''
# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.44
  '''
  SELECT "insights_sessionrecordingplaylistitem"."playlist_id" AS "playlist_id",
         "insights_sessionrecordingplaylistitem"."recording_id" AS "recording_id"
  FROM "insights_sessionrecordingplaylistitem"
  INNER JOIN "insights_sessionrecordingplaylist" ON ("insights_sessionrecordingplaylistitem"."playlist_id" = "insights_sessionrecordingplaylist"."id")
  WHERE ("insights_sessionrecordingplaylist"."team_id" = 99999
         AND "insights_sessionrecordingplaylistitem"."playlist_id" IN (1,
                                                                      2,
                                                                      3,
                                                                      4,
                                                                      5 /* ... */))
  '''
# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.45
  '''
  SELECT "insights_sessionrecordingviewed"."session_id" AS "session_id"
  FROM "insights_sessionrecordingviewed"
  WHERE ("insights_sessionrecordingviewed"."team_id" = 99999
         AND "insights_sessionrecordingviewed"."user_id" = 99999
         AND "insights_sessionrecordingviewed"."session_id" IN ('00000000-0000-0000-0000-000000000000'))
  '''
# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.46
  '''
  SELECT COUNT(*) AS "__count"
  FROM "insights_sessionrecordingviewed"
  WHERE ("insights_sessionrecordingviewed"."team_id" = 99999
         AND "insights_sessionrecordingviewed"."user_id" = 99999)
  '''
# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.47
  '''
  SELECT COUNT(*)
  FROM
    (SELECT DISTINCT "insights_comment"."item_id" AS "item_id"
     FROM "insights_comment"
     WHERE (NOT "insights_comment"."deleted"
            AND "insights_comment"."scope" = 'Replay'
            AND "insights_comment"."team_id" = 99999
            AND NOT ("insights_comment"."item_id" IS NULL))) subquery
  '''
# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.48
  '''
  SELECT COUNT(*)
  FROM
    (SELECT DISTINCT "insights_sharingconfiguration"."recording_id" AS "recording__session_id"
     FROM "insights_sharingconfiguration"
     WHERE ("insights_sharingconfiguration"."enabled"
            AND "insights_sharingconfiguration"."team_id" = 99999
            AND NOT ("insights_sharingconfiguration"."recording_id" IS NULL))) subquery
  '''
# ---
# name: TestSessionRecordingPlaylist.test_filters_playlist_by_type.49
  '''
  SELECT COUNT(*)
  FROM
    (SELECT DISTINCT ("insights_exportedasset"."export_context" -> 'session_recording_id') AS "export_context__session_recording_id"
     FROM "insights_exportedasset"
     WHERE (("insights_exportedasset"."expires_after" >= '2025-01-01 12:00:00+00:00'::timestamptz
             OR "insights_exportedasset"."expires_after" IS NULL)
            AND "insights_exportedasset"."team_id" = 99999
            AND "insights_exportedasset"."export_context" ? 'session_recording_id'
            AND NOT (("insights_exportedasset"."export_context" -> 'session_recording_id') IS NULL)
            AND NOT (("insights_exportedasset"."export_context" -> 'session_recording_id') = '""'::jsonb
                     AND "insights_exportedasset"."export_context" IS NOT NULL))) subquery
  '''
