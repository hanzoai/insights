# Applied after the table above. `Lemon<Component>` is the design-system
# prefix strip: LemonButton -> Button. `hog` alone means a script, and `hoge`
# is that script compiled -- upstream's pairing, kept as `.py`/`.pyc` keeps it,
# because the two names have to stay one letter apart or the compiler and the
# runner stop agreeing about what they hand each other.
CONTENT_REGEX: list[tuple[re.Pattern[str], str]] = [
    # `Lemon` names our design system, but it also opens `LemonSqueezy` -- a
    # payments vendor whose warehouse source we import. Stripping the prefix off
    # a name we do not own renames someone else's product to `Squeezy`, so the
    # third parties are named here and the rule declines them.
    (re.compile(r"\bLemon(?!Squeezy)(?=[A-Z][A-Za-z0-9]*)"), ""),
    # The query language and the VM. Only the prefix is ours -- `QL` is SQL's
    # and `VM` is a virtual machine's -- so the rule renames the prefix and
    # leaves the suffix's casing exactly as the author wrote it. One rule per
    # prefix casing covers every spelling in the tree and every one upstream
    # coins next, which a table of whole-word pairs cannot: it was seven pairs
    # deep and still missing `Hogql`, `hogQl`, `HogQl`, `Hogvm`, `hogVm` and
    # `HOGVM`. Ahead of the bare `hog` word rule, which these overlap.
    (re.compile(r"HOG(?=[Qq][Ll])"), "INSIGHTS"),
    (re.compile(r"Hog(?=[Qq][Ll])"), "Insights"),
    (re.compile(r"hog(?=[Qq][Ll])"), "insights"),
    (re.compile(r"HOG(?=[Vv][Mm])"), "SCRIPT"),
    (re.compile(r"Hog(?=[Vv][Mm])"), "Script"),
    (re.compile(r"hog(?=[Vv][Mm])"), "script"),
    # Ahead of the bare word only for reading order: `hog` cannot match inside
    # `hoge` anyway, because `g`->`e` is not a boundary. That asymmetry is what
    # split the language three ways before -- `".hog"` was rewritten to
    # `".script"` and `".hoge"` was left alone, so the runner looked for one
    # extension, the compiler wrote another, and the files on disk carried a
    # third. One rule per spelling, in one table, is the fix.
    (re.compile(r"\bhoge\b"), "scriptc"),
    (re.compile(r"\bHoge\b"), "Scriptc"),
    (re.compile(r"\bhog\b"), "script"),
    (re.compile(r"\bHog\b"), "Script"),
    # Django squashes app label and model name into one lowercase word for a
    # table, so the separatorless spelling is the shape a PHYSICAL name takes:
    # `insights_hogfunction`, the constraint `unique_hogfunction_revision_
    # version`, the migration `0948_hogfunction_batch_export`. Those are
    # identities the database holds, refused here for the same reason
    # MIGRATION_RE refuses a migration filename. The lookbehind is the whole
    # distinction: joined to a word on its left it is a database identifier,
    # standing at a token boundary it is a label -- a kea path, a toast id, a
    # template directory -- and only labels are ours to rename.
    (re.compile(r"(?<![A-Za-z0-9_])hogfunction"), "insightsfunction"),
]

# --- the ordering invariant ---------------------------------------------
#
# Order is load-bearing in two directions, and only one of them was ever
# written down. A rule whose pattern CONTAINS the brand -- `posthog.com`,
# `@posthog/` -- must run BEFORE the brand rule, or the brand rule fires first
# and the compound never matches. That much the table has always said. The
# other direction is that a rule need not contain the brand to destroy it: it
# only has to overlap the brand's edge. `HOG_` overlaps the right edge of
# `POSTHOG_`, so running it first split `POSTHOG_TEAM_ID` into `POST` + `FN_`,
# and the brand rule -- correctly ordered last, per the old reasoning -- then
# had nothing left to match. The result was `POSTFN_TEAM_ID`: a name nothing
# defines, nothing sets, and no reader of the table would predict. It reached
# production and crash-looped there.
#
# The brand as it is actually spelled. Their replacements are read out of the
# table rather than restated here, so the two cannot drift apart.
BRAND_TOKENS = ("POSTHOG", "PostHog", "Posthog", "postHog", "posthog")

# A brand token almost never stands alone -- it is `POSTHOG_TEAM_ID`,
# `posthogInstance`, `PostHog2` -- and it is the character AFTER it that gives
# an adjacent rule something to overlap. Deliberately excludes `-`, `.` and `/`:
# those legitimately begin a compound the table handles first (`posthog-js`,
# `posthog.com`, `@posthog/`), so probing them would report a working rule as a
# violation.
IDENT_CONTINUATIONS = ("_", "A", "z", "0")

