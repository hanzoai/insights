#!/usr/bin/env python3
"""Turn an upstream PostHog tree into the Hanzo Insights tree.

This is the single source of truth for the fork's rename. Convergence with
upstream is a recurring job, so the rename is a program, not a memory: point
this at a freshly-imported upstream tree and it reproduces our naming exactly.

    bin/debrand              rewrite content, then rename paths
    bin/debrand --check      assert the invariants; exit 1 on violation
    bin/debrand --stat       report what would change, touch nothing

Idempotent: applying it to an already-debranded tree is a no-op. That holds
because no rule's replacement contains another rule's pattern, and the rules
are applied longest-pattern-first so `posthog` is consumed before the bare
`hog` rule can see it.

Rules are derived from the shipped fork, not invented. `bin/debrand --verify`
in the convergence notes explains how to re-measure them against a known-good
tree when upstream renames something out from under us.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import re
import subprocess
import sys

# --- content rules ------------------------------------------------------
#
# Order is load-bearing where a pattern is a prefix of another; the table is
# grouped most-specific-first and the bare brand rules come last. `com -> ai`
# is NOT a rule: it only ever appears inside the domain, so it lives there.

