#!/usr/bin/env python3
"""Self-test for bin/debrand.

Every check here guards a defect that has already happened once. The codemod
decides what the fork contains, so when it is wrong it is wrong across
thousands of files at a time, and each of these failed silently: a tree that
still built, still booted, or still read like a valid licence.

Standalone on purpose. The repo's pytest boots Django, and a convergence in
progress is exactly when that is broken and this is most needed.

    bin/debrand-selftest
"""

from __future__ import annotations

import io
import os
import sys
import tempfile
import contextlib
import subprocess
from importlib.machinery import SourceFileLoader

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
debrand = SourceFileLoader("debrand", os.path.join(ROOT, "bin", "debrand")).load_module()

failures: list[str] = []


def check(name: str, got: object, want: object) -> None:
    if got == want:
        print(f"  \033[32mok\033[0m   {name}")
        return
    failures.append(name)
    print(f"  \033[31mFAIL\033[0m {name}\n         got  {got!r}\n         want {want!r}")


def quiet(fn, *args: object) -> object:
    """Run a detector whose job is to print a complaint, without printing it.

    The negative cases below assert that a checker fires. Letting it write its
    real FAIL line into this script's output makes a passing run read as a
    failing one.
    """
    with contextlib.redirect_stdout(io.StringIO()):
        return fn(*args)


def closure(files: dict[str, str], products: list[str]) -> set[str]:
    """Run drop_closure over a synthetic tree, dropping `products`."""
    with tempfile.TemporaryDirectory() as tmp:
        for rel, body in files.items():
            path = os.path.join(tmp, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(body)
        saved = debrand.DROP_DIRS
        debrand.DROP_DIRS = [(f"products/{p}", "test") for p in products]
        try:
            dropped, _ = debrand.drop_closure(tmp, list(files))
        finally:
            debrand.DROP_DIRS = saved
    return dropped


# A product whose Python half nothing imports but whose TypeScript half the core
# does was dropped anyway, because the closure only read Python. Django booted
# and the bundle resolved nothing — 21 files, including lib/api.ts, which 760
# files import.
check(
    "a product imported from TypeScript is held",
    closure({"frontend/src/lib/api.ts": "import type { X } from 'products/widgets/frontend/generated/api'\n"}, ["widgets"]),
    set(),
)
check(
    "a lazy scene import holds it too",
    closure({"frontend/src/productScenes.tsx": "export default { W: () => import('../../products/widgets/frontend/Scene') }\n"}, ["widgets"]),
    set(),
)
check(
    "a type-only import still holds it",
    closure({"frontend/src/x.ts": "import type { A } from 'products/widgets/frontend/types'\n"}, ["widgets"]),
    set(),
)
# The mirror image, and the more expensive mistake: a config names a product
# precisely because it is NOT built. Matching those would hold `desktop`, which
# is 4,797 files and most of what the drop is for.
check(
    "an ignore-list entry does not hold it",
    closure({"frontend/jest.config.ts": "export default { testPathIgnorePatterns: ['/products/widgets/'] }\n"}, ["widgets"]),
    {"widgets"},
)
check(
    "prose naming a product does not hold it",
    closure({"insights/api/x.py": "# see products/widgets/backend/logic.py for the pattern\n"}, ["widgets"]),
    {"widgets"},
)
check(
    "Python imports are still read",
    closure({"insights/api/x.py": "from products.widgets.backend import thing\n"}, ["widgets"]),
    set(),
)
check(
    "a doomed product citing another does not save it",
    closure({"products/widgets/backend/a.py": "from products.gadgets.backend import b\n"}, ["widgets", "gadgets"]),
    {"widgets", "gadgets"},
)

# Renaming a name in paths but not in content leaves every reference dangling:
# imports, and migration dependencies naming a renamed migration file. Assert
# the detector, not the tree — the tree only shows today's instances.
saved_rules = debrand.PATH_RULES
try:
    debrand.PATH_RULES = [("widget_box", "gadget_box")]
    check("an asymmetric path rule is refused", quiet(debrand.path_rules_have_content_counterparts), 1)
    debrand.PATH_RULES = [("hogql", "insightsql")]
    check("a symmetric path rule passes", quiet(debrand.path_rules_have_content_counterparts), 0)
finally:
    debrand.PATH_RULES = saved_rules

# A rule does not have to contain the brand to destroy it, only to overlap its
# edge. `HOG_` ran first once, split `POSTHOG_TEAM_ID` into `POST` + `FN_`, and
# left the brand rule -- ordered last, which the table said was the safe place
# for it -- with nothing to match. `POSTFN_TEAM_ID` shipped and crash-looped.
# Reproduced by moving the real rule rather than by inventing one, so the case
# stays the defect that happened.
saved_content = debrand.CONTENT_RULES
try:
    check("the shipped table leaves the brand intact", quiet(debrand.brand_survives_adjacent_rules), 0)
    overlapping = [r for r in saved_content if r[0] == "HOG_"]
    debrand.CONTENT_RULES = overlapping + [r for r in saved_content if r[0] != "HOG_"]
    check("a rule that overlaps the brand's edge is refused", quiet(debrand.brand_survives_adjacent_rules), 1)
finally:
    debrand.CONTENT_RULES = saved_content

# The other half: fixing the order stops the next convergence from minting more
# mangled names and repairs none of the ones already in the tree.
with tempfile.TemporaryDirectory() as tmp:
    subprocess.run(["git", "init", "-q", tmp], check=True)

    def write_mod(body: str) -> None:
        with open(os.path.join(tmp, "mod.py"), "w", encoding="utf-8") as fh:
            fh.write(body)
        subprocess.run(["git", "add", "-A"], cwd=tmp, check=True, capture_output=True)

    write_mod("from insights.temporal.common.search_attributes import INSIGHTS_TEAM_ID_KEY\n")
    check("a tree with no mangled names passes", quiet(debrand.check_mangled, tmp), 0)
    write_mod("from insights.temporal.common.search_attributes import POSTFN_TEAM_ID_KEY\n")
    check("a mangled name is refused", quiet(debrand.check_mangled, tmp), 1)
    write_mod("timeout = postfn_timeout_seconds\n")
    check("...in any case", quiet(debrand.check_mangled, tmp), 1)

# A licence is the one text in the tree that is not ours to rewrite: MIT grants
# the code on condition the notice travels with it. Renaming the company inside
# one still reads as a valid licence, so nothing downstream would notice.
with tempfile.TemporaryDirectory() as tmp:
    subprocess.run(["git", "init", "-q", tmp], check=True)
    notice = "MIT License\n\nCopyright (c) 2020-2026 PostHog Inc.\n"
    for rel, body in {
        "LICENSE": notice,
        "sub/LICENSE-MIT": notice,
        "NOTICE.md": notice,
        "mod.py": "import posthog\n",
    }.items():
        path = os.path.join(tmp, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
    subprocess.run(["git", "add", "-A"], cwd=tmp, check=True, capture_output=True)
    quiet(debrand.apply, tmp, False)

    def read(rel: str) -> str:
        with open(os.path.join(tmp, rel), encoding="utf-8") as fh:
            return fh.read()

    check("LICENSE is left byte-identical", read("LICENSE"), notice)
    check("a variant licence name is too", read("sub/LICENSE-MIT"), notice)
    check("so is NOTICE", read("NOTICE.md"), notice)
    check("a control file is still rewritten", read("mod.py"), "import insights\n")
    check("a laundered licence is caught", quiet(debrand.licences_unlaundered, tmp), 0)
    check("so is a dropped notice", quiet(debrand.licence_notice_survives, tmp), 0)
    with open(os.path.join(tmp, "LICENSE"), "w", encoding="utf-8") as fh:
        fh.write("Copyright (c) 2026 Insights Inc.\n")
    check("...and reported when it exists", quiet(debrand.licences_unlaundered, tmp), 1)
    # Renaming the holder is one way to break the MIT condition; deleting the
    # line is the other, and it leaves nothing behind for the check above to
    # match. Both shipped: a laundered rust/LICENSE, and a root LICENSE that
    # named only us.
    with open(os.path.join(tmp, "LICENSE"), "w", encoding="utf-8") as fh:
        fh.write("MIT License\n\nCopyright (c) 2026 Hanzo AI\n")
    check("a notice deleted rather than renamed is caught too", quiet(debrand.licences_unlaundered, tmp), 0)
    check("...by the invariant that asserts it is there", quiet(debrand.licence_notice_survives, tmp), 1)

# A brand is not only its names. The rename table walked past the upstream
# wordmark on both OAuth consent screens, on the toolbar error page and on the
# 2FA template -- drawn as vector paths, so no rule could see it -- and past the
# logo baked into index.html as a data URI, which printed it into every
# visitor's browser console. --check was green through all of it.
with tempfile.TemporaryDirectory() as tmp:
    subprocess.run(["git", "init", "-q", tmp], check=True)

    def write(rel: str, body: str) -> None:
        """Put one file in the tree and nothing else.

        Each case has to stand alone: a tree that accumulated the previous
        case's fixture would report a hit for the wrong reason, and the two
        negative cases below -- the checksum and the allowlisted mark -- would
        fail against a guard that is working correctly.
        """
        for name in os.listdir(tmp):
            if name != ".git":
                subprocess.run(["rm", "-rf", os.path.join(tmp, name)], check=True)
        path = os.path.join(tmp, rel)
        os.makedirs(os.path.dirname(path) or tmp, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
        subprocess.run(["git", "add", "-A"], cwd=tmp, check=True, capture_output=True)

    write("app.css", ".btn { background: #3d3d3d; }\n")
    check("a tree with no marks passes", quiet(debrand.check_marks, tmp), 0)

    write("app.css", ".btn { background: #1d4aff; }\n")
    check("a brand hue is refused", quiet(debrand.check_marks, tmp), 1)
    write("app.css", ".btn { background: #F54E00; }\n")
    check("...in any case", quiet(debrand.check_marks, tmp), 1)
    # The spelling the logo actually shipped in: percent-encoded in a data URI,
    # where `#` is `%23` and no rule matching on `#` would have found it.
    write("icon.ts", "export const SRC = 'data:image/svg+xml,%3Csvg%20fill%3D%22%23F9BD2B%22%3E'\n")
    check("...percent-encoded inside a data URI", quiet(debrand.check_marks, tmp), 1)
    write("app.css", ".btn { background: #1d4aff80; }\n")
    check("...carrying an alpha channel", quiet(debrand.check_marks, tmp), 1)
    # Decimal is the same colour wearing a spelling a hex grep cannot see. The
    # QA evidence annotator held these as PIL tuples and read as clean.
    write("overlay.py", "HIGHLIGHT_COLOR = (245, 78, 0)\n")
    check("...spelled in decimal", quiet(debrand.check_marks, tmp), 1)
    write("overlay.js", "const c = 'rgba(29,74,255,0.3)'\n")
    check("...and in an rgba() string", quiet(debrand.check_marks, tmp), 1)

    # The mirror image, and the expensive one: lockfiles are full of 64-char
    # hex, so a bare substring match would fail the tree at random.
    write("sums.txt", "checksum = \"a91d4affb27c3e5109f54e0042bd8117f9bd2b6690aa41c7d3e8b5290fc61d4a\"\n")
    check("a checksum that merely contains the run is not a hit", quiet(debrand.check_marks, tmp), 0)

    # Recolouring the wordmark to ink leaves it the upstream wordmark. A hue
    # check alone would call that fixed, which is why the geometry is refused
    # in its own right.
    write("logo.svg", '<svg><path fill="#000" d="M55.383 75.225c-1.2.4-2 1.1-2.4 2.3"/></svg>\n')
    check("the wordmark's path data is refused even when recoloured", quiet(debrand.check_marks, tmp), 1)
    write("logo.svg", '<svg><path fill="#000" d="m216.24 107.388 4.3-1.5"/></svg>\n')
    check("...by either signature", quiet(debrand.check_marks, tmp), 1)

    # Someone else's product mark keeps someone else's colours, and the
    # allowlist is the one place that exemption may be written down.
    write("vendor/logo.svg", '<svg><rect fill="#1d4aff"/></svg>\n')
    saved_allow = debrand.CONTENT_ALLOWLIST
    try:
        check("an unlisted file carrying a hue fails", quiet(debrand.check_marks, tmp), 1)
        debrand.CONTENT_ALLOWLIST = {**saved_allow, "vendor/logo.svg": "someone else's mark"}
        check("...and an allowlisted one does not", quiet(debrand.check_marks, tmp), 0)
    finally:
        debrand.CONTENT_ALLOWLIST = saved_allow


print("\nretired spellings")

# The rename runs once, on the way in. Nothing stopped a retired name walking
# back afterwards, and `--check` stayed green while it did, because it only
# looked for the company's name and these are the mascot's.
with tempfile.TemporaryDirectory() as tmp:
    subprocess.run(["git", "init", "-q", tmp], check=True)

    def write(rel: str, body: str) -> None:
        for name in os.listdir(tmp):
            if name != ".git":
                subprocess.run(["rm", "-rf", os.path.join(tmp, name)], check=True)
        path = os.path.join(tmp, rel)
        os.makedirs(os.path.dirname(path) or tmp, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
        subprocess.run(["git", "add", "-A"], cwd=tmp, check=True, capture_output=True)

    write("cli.py", 'ENV = "INSIGHTSCLI_DEBUG"\nq = "InsightsQL"\n')
    check("a converged tree passes", quiet(debrand.check_hog, tmp), 0)

    # An env var read under two names is two names, so the old prefix is
    # refused rather than aliased.
    write("cli.py", 'if os.environ.get("HOGLI_DEBUG"):\n    pass\n')
    check("the retired env prefix is refused", quiet(debrand.check_hog, tmp), 1)

    # Every casing, because the table was seven whole-word pairs deep and still
    # missing four of them.
    for spelling in ("HOGQL", "HogQL", "Hogql", "hogQL", "hogQl", "HogQl", "hogql"):
        write("q.ts", f"import {{ parse }} from './{spelling}Parser'\n")
        check(f"...and the query language spelled {spelling}", quiet(debrand.check_hog, tmp), 1)
    for spelling in ("HOGVM", "HogVM", "Hogvm", "hogVm", "hogvm"):
        write("vm.ts", f"export const {spelling}_STL = []\n")
        check(f"...and the VM spelled {spelling}", quiet(debrand.check_hog, tmp), 1)

    write("run.sh", 'exec bin/hog "$1"\n')
    check("...and the language's bare word", quiet(debrand.check_hog, tmp), 1)
    write("cli.py", 'if not name.endswith(".hoge"):\n    raise ValueError(name)\n')
    check("...and its compiled extension", quiet(debrand.check_hog, tmp), 1)

    # The third name a previous pass invented, which called the script language
    # after the SQL dialect. Refused so it cannot go back to having two.
    write("test.sh", "for f in tests/*.iql; do run $f; done\n")
    check("...and the extension that named it after the wrong language", quiet(debrand.check_hog, tmp), 1)

    # This used to assert the opposite, and the reason it flipped is the whole
    # point of the rule above. Joined to a word on its left it WAS the Postgres
    # table, and renaming a physical table is a schema change no rename may
    # make -- so `--check` deliberately let it through.
    #
    # Then the schema change was made. `insights_hogfunction` became
    # `insights_function`, the compatibility views were dropped, and the name
    # this line protected stopped resolving to anything. The exemption outlived
    # the fact that justified it, and went on protecting three relations the
    # database no longer had, while the CDP managers still selected from them.
    #
    # An exemption is a claim about the world. When the world moves, the
    # exemption becomes the bug.
    write("m.py", 'CREATE = "SELECT id FROM insights_hogfunction WHERE team_id = %s"\n')
    check("a relation the database dropped IS a leak", quiet(debrand.check_hog, tmp), 1)
    write("m.py", 'name="unique_hogfunction_revision_version"\n')
    check("...nor is a constraint built on it", quiet(debrand.check_hog, tmp), 0)
    write("logic.ts", "path(() => ['scenes', 'pipeline', 'hogfunctions'])\n")
    check("...but a label at a token boundary is", quiet(debrand.check_hog, tmp), 1)

    # A migration's filename is its identity in `django_migrations`, frozen for
    # the same reason MIGRATION_RE refuses to rename one.
    write("app/migrations/0002_alter_hogfunction_batch_export.py", "operations = []\n")
    check("a migration filename is frozen, not failed", quiet(debrand.check_hog, tmp), 0)
    write("app/hogfunction/views.py", "handler = None\n")
    check("...while any other path is refused", quiet(debrand.check_hog, tmp), 1)

    # Third-party package names cannot be renamed by us, so they are reported
    # for a decision rather than exempted -- an exemption is a decision someone
    # made, and nobody has made this one.
    write("pyproject.toml", 'dependencies = ["drf-exceptions-hog==0.4.0"]\n')
    check("a dependency manifest is pending, not failed", quiet(debrand.check_hog, tmp), 0)

    # The credential marks. These were the last of the upstream's brand a
    # customer read, and no word rule could reach them, because `ph` is not a
    # word: the constant said `phc_` while every live token said `hi_`, and the
    # middleware routed on `phc_` and so matched nothing at all. Refused as a
    # shape, so a seventh cannot be coined to replace the six.
    for mark in ("phc_", "phx_", "phs_", "pha_", "phr_", "phvt_"):
        write("sdk.md", f'insights.init("{mark}wYm3f8pDq2Lk")\n')
        check(f"the retired credential mark {mark} is refused", quiet(debrand.check_hog, tmp), 1)
    write("sdk.md", 'insights.init("pk-wYm3f8pDq2Lk")\n')
    check("...while the mark that replaced them passes", quiet(debrand.check_hog, tmp), 0)
    write("keys.py", 'SECRET = "sk-wYm3f8pDq2Lk"\nACCESS = "at-x"\nREFRESH = "rt-x"\nVERIFY = "vt-x"\n')
    check("...as do the secret and protocol marks", quiet(debrand.check_hog, tmp), 0)

    # Declined, and each for a reason that is not "it looks close enough": two
    # open a third-party package name, and one is the analytics client handle.
    write("Cargo.lock", 'name = "phf_shared"\n')
    check("a third-party crate is not a credential mark", quiet(debrand.check_hog, tmp), 0)
    write("q.sql", "SELECT count() FROM php_events\n")
    check("...nor is a table named after another language", quiet(debrand.check_hog, tmp), 0)
    write("report.py", "pha_client = get_ph_client()\n")
    check("...nor is the analytics client handle", quiet(debrand.check_hog, tmp), 0)
    write("contact.py", "phone_number = row.phone_number_id\nphase_id = row.phase_seconds\n")
    check("...nor are words that merely start with ph", quiet(debrand.check_hog, tmp), 0)


# The two module systems are one defect wearing two syntaxes. TypeScript went
# unchecked and 190 specifiers named files that had been renamed away, which is
# the whole CDP consumer graph -- the event worker, not the web boot.
#
# Rooted at an empty directory, not at this repo: `ts_file` asks the filesystem
# whether a specifier names a directory, so against the real tree these cases
# would answer differently the day someone adds a directory that happens to
# match, and a test that depends on what else is on disk is not a test.
with tempfile.TemporaryDirectory() as tmp:
    check(
        "a stale TypeScript specifier is repointed at where the file went",
        debrand.ts_ref_target(
            "./services/insightsflows/hogflow-utils",
            "nodejs/src/cdp/cdp-api.ts",
            {"nodejs/src/cdp/services/insightsflows/insightsflow-utils.ts"},
            tmp,
        ),
        "./services/insightsflows/insightsflow-utils",
    )
    check(
        "...through the alias spelling too",
        debrand.ts_ref_target(
            "~/cdp/schema/hogflow",
            "nodejs/src/cdp/types.ts",
            {"nodejs/src/cdp/schema/insightsflow.ts"},
            tmp,
        ),
        "~/cdp/schema/insightsflow",
    )
    # Renaming a specifier no rule can resolve would be a guess, and a guess
    # wires the app to the wrong module without saying so.
    check(
        "a specifier that resolves is left alone",
        debrand.ts_ref_target(
            "./insightsflow-utils",
            "nodejs/src/cdp/a.ts",
            {"nodejs/src/cdp/insightsflow-utils.ts"},
            tmp,
        ),
        None,
    )
    check(
        "...and so is one that resolves under neither spelling",
        debrand.ts_ref_target("./gone", "nodejs/src/cdp/a.ts", set(), tmp),
        None,
    )


print("\nnames that are not ours to spell")

# A rule that strips our design-system prefix ate a payments vendor whose
# warehouse source we import, renaming their product to `Squeezy`.
check("a third-party product keeps its name", debrand.rewrite_text("LemonSqueezy"), "LemonSqueezy")
check("...while the design-system prefix still comes off", debrand.rewrite_text("LemonButton"), "Button")

# These four are read back by something that was not rebuilt from this
# checkout: Postgres, the Datastore, and a client on the wire. The `hog_flow`
# rules would have renamed all four on the next run, which is a data incident
# and not a refactor.
for ident in ("insights_hogflow", "system.hog_flows", "hog_flow_id", "/v1/environments/2/hog_flows/"):
    check(f"{ident} survives the rewrite", debrand.rewrite_text(ident), ident)
# The line that separates an identity from a label: the module is a label, and
# renaming it is the file move the rules exist to make.
check(
    "...while the module of the same name still moves",
    debrand.rewrite_text("insights/tasks/hog_flows.py"),
    "insights/tasks/insights_flows.py",
)

# The storage engine, one layer down. Our fork is Datastore and every label we
# chose says so, but these six spellings are read back by a program that was not
# built from this checkout, and the rules renamed all six until they were held.
# Each line below broke something specific: a dictionary the server refuses to
# create, an import of a class the package does not export, an option key the
# server never sees, a derive macro with nothing to resolve, and an alias
# pointing at itself.
for ident in (
    "SOURCE(CLICKHOUSE(TABLE 't'))",
    "import { ClickHouseClient as DatastoreClient } from '@datastore/client'",
    "from datastore_connect.driver.exceptions import ClickHouseError as DatastoreError",
    "clickhouse_settings: { max_execution_time: 30 }",
    "use datastore as clickhouse;",
):
    check(f"{ident[:44]} survives the rewrite", debrand.rewrite_text(ident), ident)
check(
    "an npm alias keeps the scope it resolves to, caret and all",
    debrand.rewrite_text("'@datastore/client': 'npm:@clickhouse/client@^1.12.0'", "pnpm-workspace.yaml"),
    "'@datastore/client': 'npm:@clickhouse/client@^1.12.0'",
)
# The other side of that line: a name we chose is ours, in every casing. The
# camelCase one is the spelling a table of whole-word pairs keeps missing.
check("...while an identifier we named still moves", debrand.rewrite_text("clickHouseTimestampToISO"), "datastoreTimestampToISO")
check("...and so does a setting we read", debrand.rewrite_text("CLICKHOUSE_HOST"), "DATASTORE_HOST")


# Applying the rules to an already-converged tree has to be a no-op, or every
# rerun produces a diff and convergence never terminates.
sample = "from insights.insightsql import datastore  # @hanzo/elements, InsightsFunction\n"
check("content rewriting is idempotent", debrand.rewrite_text(debrand.rewrite_text(sample)), debrand.rewrite_text(sample))

# One probe per path rule, built from the rule's own pattern rather than written
# out here. A hand-picked fixture tests one path and has to spell the upstream
# names to do it -- which is how `posthog/hogql/clickhouse.py` sat in this file,
# naming both the brand and the engine, exempt because the allowlist exempts
# files and this file is on it for its licence and import fixtures. Reading the
# tables instead covers every rule, spells nothing, and cannot fall behind a
# rule someone adds later.
path_probes = (
    [old + "/x.py" for old, _ in debrand.PATH_DIR_RULES]      # matched on prefix
    + [f"a/{old}/b.py" for old, _ in debrand.PATH_RULES]      # matched anywhere
    + [f"a/{base}" for base in debrand.PATH_EXACT_RULES]      # matched on basename
)
once = [debrand.rewrite_path(p) for p in path_probes]
check(
    "path rewriting is idempotent",
    [debrand.rewrite_path(p) for p in once],
    once,
)
# A probe is built from a rule's own left-hand side, so a probe that comes back
# unchanged is a rule that no longer fires -- shadowed by an earlier one, or
# left behind by a rename it was written for.
check("every path rule fires", [p for p, o in zip(path_probes, once) if p == o], [])

print()
if failures:
    print(f"\033[31m{len(failures)} check(s) failed\033[0m: {', '.join(failures)}")
    sys.exit(1)
print("\033[32mall checks passed\033[0m")
