  FROM "insights_sessionrecordingviewed"
  INNER JOIN "insights_user" ON ("insights_sessionrecordingviewed"."user_id" = "insights_user"."id")
  WHERE ("insights_sessionrecordingviewed"."session_id" IN ('at_base_time_plus_20',
                                                           'at_base_time')
         AND "insights_sessionrecordingviewed"."team_id" = 99999
         AND NOT ("insights_sessionrecordingviewed"."user_id" = 99999))
  '''
