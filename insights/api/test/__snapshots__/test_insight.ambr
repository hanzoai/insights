         "insights_dashboard"."tags",
         "insights_dashboard"."share_token",
         "insights_dashboard"."is_shared"
  FROM "insights_dashboard"
  INNER JOIN "insights_dashboardtile" ON ("insights_dashboard"."id" = "insights_dashboardtile"."dashboard_id")
  WHERE (NOT ("insights_dashboard"."deleted")
         AND "insights_dashboardtile"."insight_id" = 99999)
  '''
# ---
# name: TestInsight.test_listing_insights_does_not_nplus1.19
  '''
  SELECT "insights_dashboardtile"."id",
         "insights_dashboardtile"."dashboard_id",
         "insights_dashboardtile"."insight_id",
         "insights_dashboardtile"."text_id",
         "insights_dashboardtile"."layouts",
         "insights_dashboardtile"."color",
         "insights_dashboardtile"."filters_hash",
         "insights_dashboardtile"."last_refresh",
         "insights_dashboardtile"."refreshing",
         "insights_dashboardtile"."refresh_attempt",
         "insights_dashboardtile"."filters_overrides",
         "insights_dashboardtile"."deleted"
  FROM "insights_dashboardtile"
  INNER JOIN "insights_dashboard" ON ("insights_dashboardtile"."dashboard_id" = "insights_dashboard"."id")
  WHERE (NOT ("insights_dashboardtile"."deleted"
              AND "insights_dashboardtile"."deleted" IS NOT NULL)
         AND NOT ("insights_dashboard"."deleted")
