         T4."onboarding_delegated_to_organization_id",
         T4."onboarding_delegation_accepted_at",
         T4."events_column_config",
         T4."email_opt_in"
  FROM "insights_sessionrecordingplaylist"
  INNER JOIN "insights_team" ON ("insights_sessionrecordingplaylist"."team_id" = "insights_team"."id")
  LEFT OUTER JOIN "insights_user" ON ("insights_sessionrecordingplaylist"."created_by_id" = "insights_user"."id")
  LEFT OUTER JOIN "insights_user" T4 ON ("insights_sessionrecordingplaylist"."last_modified_by_id" = T4."id")
  WHERE (NOT "insights_sessionrecordingplaylist"."deleted"
         AND NOT "insights_sessionrecordingplaylist"."deleted"
         AND "insights_sessionrecordingplaylist"."type" = 'filters'
         AND "insights_sessionrecordingplaylist"."team_id" = 99999
         AND NOT "insights_sessionrecordingplaylist"."deleted"
         AND NOT "insights_sessionrecordingplaylist"."deleted"
         AND "insights_sessionrecordingplaylist"."type" = 'filters')
  ORDER BY "insights_sessionrecordingplaylist"."last_modified_at" DESC,
           "insights_sessionrecordingplaylist"."id" ASC
  LIMIT 100
