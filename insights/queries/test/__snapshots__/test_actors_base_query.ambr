# name: TestActorsBaseQuery.test_get_serialized_people_empty
  '''
  SELECT insights_person.id,
         insights_person.uuid,
         insights_person.properties,
         insights_person.is_identified,
         insights_person.created_at
  FROM insights_person
  WHERE insights_person.uuid = ANY('{}')
    AND insights_person.team_id = 99999
  ORDER BY created_at DESC,
           uuid
  '''
# ---
# name: TestActorsBaseQuery.test_get_serialized_people_empty.1
  '''
  SELECT insights_persondistinctid.person_id,
         insights_persondistinctid.distinct_id
  FROM insights_persondistinctid
  WHERE insights_persondistinctid.person_id = ANY('{}')
    AND insights_persondistinctid.team_id = 99999
  '''
# ---
# name: TestActorsBaseQuery.test_serialize_groups_with_values
  '''
  SELECT "insights_group"."id",
         "insights_group"."team_id",
         "insights_group"."group_key",
         "insights_group"."group_type_index",
         "insights_group"."group_properties",
         "insights_group"."created_at",
         "insights_group"."properties_last_updated_at",
         "insights_group"."properties_last_operation",
         "insights_group"."version"
  FROM "insights_group"
  WHERE "insights_group"."group_key" IN ('company_a',
                                        'company_b')
