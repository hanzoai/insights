# name: TestSessionRecordings.test_listing_recordings_is_not_nplus1_for_persons.130
  '''
  SELECT DISTINCT ON ("ee_single_session_summary"."session_id") "ee_single_session_summary"."session_id" AS "session_id",
                     ("ee_single_session_summary"."summary" -> 'session_outcome') AS "summary__session_outcome",
                     "ee_single_session_summary"."extra_summary_context" AS "extra_summary_context"
  FROM "ee_single_session_summary"
  WHERE ("ee_single_session_summary"."session_id" IN ('8',
                                                      '7',
                                                      '6',
                                                      '5',
                                                      '4',
                                                      '3',
                                                      '2',
                                                      '1')
         AND "ee_single_session_summary"."team_id" = 99999
         AND "ee_single_session_summary"."extra_summary_context" IS NULL)
  ORDER BY 1 ASC,
           "ee_single_session_summary"."created_at" DESC
  '''
