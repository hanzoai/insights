     WHERE (U0."project_id" = ("insights_team"."project_id")
            AND ((U0."session_recording_linked_flag" -> 'id'))::integer = ("insights_featureflag"."id"))
     LIMIT 1) AS "is_used_in_replay_settings_annotation",
