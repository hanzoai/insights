         "insights_featureflag"."rollout_percentage",
         "insights_featureflag"."team_id",
         "insights_featureflag"."created_by_id",
         "insights_featureflag"."created_at",
         "insights_featureflag"."updated_at",
         "insights_featureflag"."deleted",
         "insights_featureflag"."active",
         "insights_featureflag"."version",
         "insights_featureflag"."last_modified_by_id",
         "insights_featureflag"."rollback_conditions",
         "insights_featureflag"."performed_rollback",
         "insights_featureflag"."ensure_experience_continuity",
         "insights_featureflag"."usage_dashboard_id",
         "insights_featureflag"."has_enriched_analytics",
         "insights_featureflag"."is_remote_configuration",
         "insights_featureflag"."has_encrypted_payloads",
         "insights_featureflag"."evaluation_runtime",
         "insights_featureflag"."bucketing_identifier",
         "insights_featureflag"."last_called_at"
  FROM "insights_featureflag"
  INNER JOIN "insights_team" ON ("insights_featureflag"."team_id" = "insights_team"."id")
  WHERE (NOT "insights_featureflag"."deleted"
         AND "insights_featureflag"."key" = 'copied-flag-key'
         AND "insights_team"."project_id" = 99999)
  ORDER BY "insights_featureflag"."id" ASC
  LIMIT 1
  '''
