         T5."has_seen_product_intro_for",
         T5."strapi_id",
         T5."is_active",
         T5."role_at_organization",
         T5."theme_mode",
         T5."partial_notification_settings",
         T5."anonymize_data",
         T5."allow_impersonation",
         T5."toolbar_mode",
         T5."mascot_config",
         T5."allow_sidebar_suggestions",
         T5."shortcut_position",
         T5."passkeys_enabled_for_2fa",
         T5."hide_mcp_hints",
         T5."ui_configuration",
         T5."onboarding_skipped_at",
         T5."onboarding_skipped_reason",
         T5."onboarding_skipped_organization_id",
