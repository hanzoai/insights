let fibonacci := (number) -> {
    if (number < 2) {
        return number;
    } else {
        return fibonacci(number - 1) + fibonacci(number - 2);
    }
}

print(fibonacci(6))

fun fib(number) {
    if (number < 2) {
        return number;
    } else {
        return fib(number - 1) + fib(number - 2);
    }
}

print(fib(6))
