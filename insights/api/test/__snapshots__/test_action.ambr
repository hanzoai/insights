# name: TestActionApi.test_listing_actions_is_not_nplus1.7
  '''
  SELECT "insights_action"."id",
         "insights_action"."name",
         "insights_action"."description",
         "insights_action"."team_id",
         "insights_action"."project_id",
         "insights_action"."created_at",
         "insights_action"."created_by_id",
         "insights_action"."deleted",
         "insights_action"."post_to_slack",
         "insights_action"."slack_message_format",
         "insights_action"."updated_at",
         "insights_action"."bytecode",
         "insights_action"."bytecode_error",
         "insights_action"."steps_json",
         "insights_action"."pinned_at",
         "insights_action"."summary",
         "insights_action"."last_summarized_at",
         "insights_action"."embedding_last_synced_at",
         "insights_action"."embedding_version",
         "insights_action"."is_calculating",
         "insights_action"."last_calculated_at",
         COUNT("insights_action_events"."event_id") AS "count",
         "insights_user"."id",
         "insights_user"."password",
         "insights_user"."last_login",
         "insights_user"."first_name",
         "insights_user"."last_name",
         "insights_user"."is_staff",
         "insights_user"."date_joined",
         "insights_user"."uuid",
         "insights_user"."current_organization_id",
         "insights_user"."current_team_id",
         "insights_user"."email",
         "insights_user"."pending_email",
         "insights_user"."distinct_id",
         "insights_user"."is_email_verified",
         "insights_user"."credentials_reviewed_at",
         "insights_user"."requested_password_reset_at",
         "insights_user"."requested_2fa_reset_at",
         "insights_user"."has_seen_product_intro_for",
         "insights_user"."strapi_id",
         "insights_user"."is_active",
         "insights_user"."role_at_organization",
         "insights_user"."theme_mode",
         "insights_user"."partial_notification_settings",
         "insights_user"."anonymize_data",
         "insights_user"."allow_impersonation",
         "insights_user"."toolbar_mode",
         "insights_user"."mascot_config",
         "insights_user"."allow_sidebar_suggestions",
         "insights_user"."shortcut_position",
         "insights_user"."passkeys_enabled_for_2fa",
         "insights_user"."hide_mcp_hints",
         "insights_user"."onboarding_skipped_at",
         "insights_user"."onboarding_skipped_reason",
         "insights_user"."onboarding_skipped_organization_id",
         "insights_user"."onboarding_delegated_to_invite_id",
         "insights_user"."onboarding_delegated_to_organization_id",
         "insights_user"."onboarding_delegation_accepted_at",
         "insights_user"."events_column_config",
         "insights_user"."email_opt_in"
  FROM "insights_action"
  LEFT OUTER JOIN "insights_action_events" ON ("insights_action"."id" = "insights_action_events"."action_id")
  INNER JOIN "insights_team" ON ("insights_action"."team_id" = "insights_team"."id")
  LEFT OUTER JOIN "insights_user" ON ("insights_action"."created_by_id" = "insights_user"."id")
  WHERE (NOT "insights_action"."deleted"
         AND ("insights_action"."team_id" =
                (SELECT U0."parent_team_id" AS "parent_team_id"
                 FROM "insights_team" U0
                 WHERE U0."id" = 99999
                 LIMIT 1)
              OR ("insights_team"."parent_team_id" IS NULL
                  AND "insights_action"."team_id" = 99999))
         AND "insights_team"."project_id" = 99999)
  GROUP BY "insights_action"."id",
           "insights_user"."id"
  ORDER BY "insights_action"."last_calculated_at" DESC,
           "insights_action"."name" ASC
  '''
