#!/bin/bash
set -e

if [[ "$@" == *".iql"* ]]; then
  exec python3 -m insights.insightsql.cli --compile "$@"
elif [[ "$@" == *".js"* ]]; then
  exec python3 -m insights.insightsql.cli --compile "$@"
else
  echo "$0 - the IQL compiler"
  echo ""
  echo "Usage:     bin/iqle <file.iql> [output.iqle]  compile .iql into .iqle"
  echo "           bin/iqle <file.iql> <output.js>     compile .iql into .js"
  echo "           bin/iql <file.iql>                  run .iql source code"
  echo "           bin/iql <file.iqle>                 run compiled .iqle bytecode"
  exit 1
fi
