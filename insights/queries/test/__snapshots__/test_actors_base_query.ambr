# serializer version: 1
# name: TestActorsBaseQuery.test_get_groups
  '''
  SELECT "insights_group"."id",
         "insights_group"."team_id",
         "insights_group"."group_key",
         "insights_group"."group_type_index",
         "insights_group"."group_properties",
         "insights_group"."created_at",
         "insights_group"."properties_last_updated_at",
         "insights_group"."properties_last_operation",
         "insights_group"."version"
  FROM "insights_group"
  WHERE ("insights_group"."group_key" IN ('org_1',
                                         'org_2')
         AND "insights_group"."group_type_index" = 99999
         AND "insights_group"."team_id" = 99999)
  '''
# ---
# name: TestActorsBaseQuery.test_get_people_with_distinct_id_limit
  '''
  SELECT "insights_person"."id",
         "insights_person"."created_at",
         "insights_person"."team_id",
         "insights_person"."properties",
         "insights_person"."is_identified",
         "insights_person"."uuid"
  FROM "insights_person"
  WHERE ("insights_person"."team_id" = 99999
         AND "insights_person"."uuid" IN ('00000000000000000000000000000000'::uuid))
  ORDER BY "insights_person"."created_at" DESC,
           "insights_person"."uuid" ASC
  '''
# ---
# name: TestActorsBaseQuery.test_get_people_with_distinct_id_limit.1
  '''
  SELECT "insights_persondistinctid"."id",
         "insights_persondistinctid"."team_id",
         "insights_persondistinctid"."person_id",
         "insights_persondistinctid"."distinct_id",
         "insights_persondistinctid"."version"
  FROM "insights_persondistinctid"
  WHERE ("insights_persondistinctid"."id" IN
           (SELECT U0."id"
            FROM "insights_persondistinctid" U0
            WHERE U0."person_id" = ("insights_persondistinctid"."person_id")
            LIMIT 3)
         AND "insights_persondistinctid"."person_id" IN (1,
                                                        2,
                                                        3,
                                                        4,
                                                        5 /* ... */))
  '''
# ---
# name: TestActorsBaseQuery.test_get_people_with_prefetch
  '''
  SELECT "insights_person"."id",
         "insights_person"."created_at",
         "insights_person"."team_id",
         "insights_person"."properties",
         "insights_person"."is_identified",
         "insights_person"."uuid"
  FROM "insights_person"
  WHERE ("insights_person"."team_id" = 99999
         AND "insights_person"."uuid" IN ('00000000000000000000000000000000'::uuid,
                                         '00000000000000000000000000000000'::uuid))
  ORDER BY "insights_person"."created_at" DESC,
           "insights_person"."uuid" ASC
  '''
