# ---
# name: TestOrganizationFeatureFlagCopy.test_copy_feature_flag_create_new.23
  '''
  SELECT 1 AS "_check"
  WHERE COALESCE((EXISTS
                    (SELECT 1 AS "a"
                     FROM "insights_taggeditem" U0
                     WHERE (U0."dashboard_id" = 99999
                            AND U0."tag_id" = '00000000000000000000000000000000'::uuid
                            AND U0."dashboard_id" IS NOT NULL)
                     LIMIT 1)), true)
  '''
