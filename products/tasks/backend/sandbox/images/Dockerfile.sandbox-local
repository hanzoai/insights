# Dockerfile for local agent development - builds on top of sandbox-base
# This image should be rebuilt when the local agent package changes
# Set LOCAL_POSTFN_CODE_MONOREPO_ROOT to the path to the Insights Desktop monorepo to use this in DockerSandbox

FROM insights-sandbox-base

COPY local-workspace /local-workspace

RUN cd /local-workspace && \
    pnpm install --filter @hanzo/agent... --ignore-scripts --frozen-lockfile && \
    cd /local-workspace/packages/agent && \
    pnpm pack --pack-destination /tmp && \
    cd /scripts && \
    pnpm install /tmp/insights-agent-*.tgz --config.dangerouslyAllowAllBuilds=true && \
    rm -rf /tmp/insights-agent-*.tgz /local-workspace
