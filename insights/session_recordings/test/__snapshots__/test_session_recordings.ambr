  FROM "insights_datawarehousejoin"
  WHERE ("insights_datawarehousejoin"."team_id" = 99999
         AND NOT ("insights_datawarehousejoin"."deleted"
                  AND "insights_datawarehousejoin"."deleted" IS NOT NULL))
  '''
# ---
# name: TestSessionRecordings.test_listing_recordings_is_not_nplus1_for_persons.37
