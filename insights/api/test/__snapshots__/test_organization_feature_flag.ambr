# name: TestOrganizationFeatureFlagCopy.test_copy_feature_flag_create_new.17
  '''
  SELECT "insights_dashboardtile"."id"
  FROM "insights_dashboardtile"
  INNER JOIN "insights_dashboard" ON ("insights_dashboardtile"."dashboard_id" = "insights_dashboard"."id")
  WHERE (NOT ("insights_dashboardtile"."deleted"
              AND "insights_dashboardtile"."deleted" IS NOT NULL)
         AND NOT ("insights_dashboard"."deleted")
         AND "insights_dashboardtile"."dashboard_id" = 99999)
  '''
# ---
# name: TestOrganizationFeatureFlagCopy.test_copy_feature_flag_create_new.18
  '''
  SELECT "insights_tag"."id",
         "insights_tag"."name",
         "insights_tag"."team_id"
  FROM "insights_tag"
  INNER JOIN "insights_team" ON ("insights_tag"."team_id" = "insights_team"."id")
  WHERE (("insights_tag"."team_id" =
            (SELECT U0."parent_team_id"
             FROM "insights_team" U0
             WHERE U0."id" = 99999
             LIMIT 1)
          OR ("insights_team"."parent_team_id" IS NULL
              AND "insights_tag"."team_id" = 99999))
         AND "insights_tag"."name" = 'feature flags')
  LIMIT 21
  '''
