{
  "name": "@hanzo/quill-storybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "pnpm --filter @hanzo/quill-tokens build && storybook dev -p 6006",
    "build-storybook": "pnpm --filter @hanzo/quill-tokens build && storybook build",
    "test:visual:ci:update": "pnpm exec test-storybook -u --junit --no-index-json --maxWorkers=1",
    "test:visual:ci:verify": "pnpm exec test-storybook --ci --junit --no-index-json --maxWorkers=1",
    "test:visual:debug": "PWDEBUG=1 pnpm exec test-storybook --browsers chromium --no-index-json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@hanzo/quill": "workspace:^",
    "@hanzo/quill-charts": "workspace:^",
    "@hanzo/quill-tokens": "workspace:^",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-scroll-mask": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-docs": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/test-runner": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/jest-image-snapshot": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "chokidar": "catalog:",
    "jest-image-snapshot": "catalog:",
    "storybook": "catalog:",
    "storybook-addon-pseudo-states": "catalog:",
    "storybook-dark-mode": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
