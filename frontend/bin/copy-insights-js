#!/bin/sh

set -e

# This script copies built files from @hanzo/insights so they can be served on the CDN.
# The package is a workspace dependency at node_modules/@hanzo/insights.

if [ -d "node_modules/@hanzo/insights/dist" ]; then
    PKG_DIR="node_modules/@hanzo/insights"
elif [ -d "node_modules/insights-js/dist" ]; then
    PKG_DIR="node_modules/insights-js"
else
    echo "ERROR: Cannot find @hanzo/insights in node_modules" >&2
    exit 1
fi

cp "$PKG_DIR"/dist/array.js* dist/
cp "$PKG_DIR"/dist/array.full.js* dist/
cp "$PKG_DIR"/dist/array.full.es5.js* dist/
cp "$PKG_DIR"/dist/surveys.js* dist/
cp "$PKG_DIR"/dist/logs.js* dist/
cp "$PKG_DIR"/dist/exception-autocapture.js* dist/
cp "$PKG_DIR"/dist/web-vitals.js* dist/
cp "$PKG_DIR"/dist/tracing-headers.js* dist/
cp "$PKG_DIR"/dist/dead-clicks-autocapture.js* dist/
cp "$PKG_DIR"/dist/customizations.full.js* dist/
# there are multiple external integrations that we use, so we need to copy them all
cp "$PKG_DIR"/dist/*integration.js* dist/ 2>/dev/null || true
# there are multiple recorder files that we use, so we need to copy them all
cp "$PKG_DIR"/dist/*recorder*.js* dist/ 2>/dev/null || true
cp "$PKG_DIR"/dist/product-tours.js* dist/
cp "$PKG_DIR"/dist/conversations.js* dist/
