#!/usr/bin/env bash
#
# Can this build read our own Python SDK?
#
# hanzo-insights is pinned to git.hanzo.ai (see [tool.uv.sources] in
# pyproject.toml for why the archived github.com mirror cannot serve it), and the
# forge answers nothing anonymously. Without a working credential `uv sync` fails
# — but it fails deep inside a 30-60 minute image build, with a git auth error
# against a URL that reads like a network blip. This asks the same question in two
# seconds, before anything is spent, and says exactly what to fix.
#
# Same reason and same shape as check-imports-are-committed running at the top of
# the build job: the cheap question first.
set -euo pipefail

REPO="https://git.hanzo.ai/hanzoai/insights-python"

if [ -z "${FORGE_TOKEN:-}" ]; then
    echo "::error::no forge credential in this job. hanzo-insights installs from ${REPO}, which needs one. Seal a token that can read it as the FORGE_TOKEN secret for this repository."
    exit 1
fi

if ! git ls-remote --exit-code "https://x:${FORGE_TOKEN}@git.hanzo.ai/hanzoai/insights-python" main >/dev/null 2>&1; then
    echo "::error::the forge credential cannot read ${REPO}, which this image installs from. Seal a token that can read it as the FORGE_TOKEN secret for this repository."
    exit 1
fi

echo "forge credential reads hanzoai/insights-python"
