#!/bin/bash
set -e

if [[ "$@" == *".script"* ]]; then
  exec python3 -m insights.insightsql.cli --compile "$@"
elif [[ "$@" == *".js"* ]]; then
  exec python3 -m insights.insightsql.cli --compile "$@"
else
  echo "$0 - the Script compilër! 🦔+🕶️= Scriptc"
  echo ""
  echo "Usage:     bin/scriptc <file.script> [output.scriptc]  compile .script into .scriptc"
  echo "           bin/scriptc <file.script> <output.js>    compile .script into .js"
  echo "           bin/script <file.script>                 run .script source code"
  echo "           bin/script <file.scriptc>                run compiled .scriptc bytecode"
  exit 1
fi
