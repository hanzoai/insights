     FROM "insights_dashboarditem"
     INNER JOIN "insights_team" ON ("insights_dashboarditem"."team_id" = "insights_team"."id")
     LEFT OUTER JOIN "insights_insightviewed" ON ("insights_dashboarditem"."id" = "insights_insightviewed"."insight_id")
     WHERE ("insights_team"."project_id" = 99999
            AND NOT ("insights_dashboarditem"."deleted"))
     GROUP BY 1) subquery
  '''
